#!/bin/bash
# Ferien und Feiertage - Deinstallation
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
# $1 ist NICHT der Arbeitsordner, sondern eine zehnstellige Zufallskennung.
# Laeuft als root; Rueckgabewert 1 = Warnung (die Deinstallation laeuft weiter).
#
# LoxBerry entfernt beim Deinstallieren nur die Ordner des Plugins selbst
# (config/plugins/<x>/, data/plugins/<x>/, bin/, templates/, webfrontend/).
# Was NEBEN diesen Ordnern liegt, bleibt liegen - dieses Skript raeumt es ab
# (I6, 1.2.16) und zaehlt danach nach; "<OK>" erst, wenn nichts mehr liegt.
# Bis 1.2.15 stand hier "<OK>" auch dann, wenn das Loeschen scheiterte
# (Installer-Pruefer F9b), und /tmp/ferien blieb liegen: eine Neuinstallation
# am selben Tag lieferte bis zu einer Stunde lang die Ferien und den Urlaub
# der deinstallierten Anlage (F9c).
#
#   config/plugins/<x>.backup.json(.alt)       Zweitschrift (Aktionstoken)
#   data/plugins/<x>.upgrade_sicherung(.neu/.alt)  Update-Sicherung
#   data/plugins/<x>.upgrade_laeuft            Marke aus preupgrade.sh
#   /tmp/<x>, /tmp/<x>-<uid>                   Zwischenstand, Merker
#
# MQTT: alle Themen dieser Linie gehen mit "publish" hinaus, keines ist
# zurueckbehalten (Entscheidung 3/8) - im Broker ist nichts abzuraeumen.
UN_FOLDER="${3:-ferien}"
UN_BASE="${5:-$LBHOMEDIR}"
case "$UN_FOLDER" in
    ''|*/*|*..*) echo "<FAIL> Unzulaessiger Ordnername '$UN_FOLDER' - nichts geloescht."; exit 1 ;;
esac
# Fail-closed (I6): sieht die Lage nicht wie ein LoxBerry aus, wird NICHTS
# geloescht. Bis 1.2.15 genuegte "-d $UN_BASE".
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE/config/plugins" ] || [ ! -d "$UN_BASE/data/plugins" ] \
   || [ ! -f "$UN_BASE/config/system/general.json" ]; then
    echo "<FAIL> '$UN_BASE' sieht nicht wie ein LoxBerry aus (config/plugins, data/plugins und"
    echo "<FAIL> config/system/general.json muessen dort liegen) - es wurde nichts geloescht."
    echo "<FAIL> Bitte von Hand nachsehen: config/plugins/$UN_FOLDER.backup.json, data/plugins/$UN_FOLDER.upgrade_*"
    exit 1
fi
UID_LB=$(id -u loxberry 2>/dev/null || id -u)
ZIELE="$UN_BASE/config/plugins/$UN_FOLDER.backup.json
$UN_BASE/config/plugins/$UN_FOLDER.backup.json.alt
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.neu
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft
/tmp/$UN_FOLDER
/tmp/$UN_FOLDER-$UID_LB
/tmp/$UN_FOLDER-eigen"
printf '%s\n' "$ZIELE" | while IFS= read -r Z; do
    [ -n "$Z" ] || continue
    if [ -e "$Z" ] || [ -L "$Z" ]; then
        rm -rf "${Z:?}" 2>/dev/null
    fi
done
UEBRIG=""
while IFS= read -r Z; do
    [ -n "$Z" ] || continue
    if [ -e "$Z" ] || [ -L "$Z" ]; then UEBRIG="$UEBRIG $Z"; fi
done <<EOF_ZIELE
$ZIELE
EOF_ZIELE
if [ -z "$UEBRIG" ]; then
    echo "<OK> Zweitschrift, Update-Sicherung, beiseitegelegte Staende, Marke und Zwischenordner entfernt (nachgezaehlt: nichts mehr da)."
    exit 0
fi
echo "<FAIL> Es liegen noch Dateien dieses Plugins neben den Plugin-Ordnern - bitte von Hand entfernen (die Zweitschrift traegt das Aktionstoken):"
for Z in $UEBRIG; do echo "<FAIL>   $Z"; done
exit 1
