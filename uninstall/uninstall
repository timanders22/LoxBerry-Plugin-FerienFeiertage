#!/bin/bash
# Ferien und Feiertage - Deinstallation
#
# LoxBerry entfernt beim Deinstallieren nur die Ordner des Plugins selbst
# (config/plugins/<x>/, data/plugins/<x>/, bin/, templates/, webfrontend/).
# Was NEBEN diesen Ordnern liegt, bleibt liegen - und genau dorthin gehoert
# alles, was ein Update ueberstehen soll. Beides raeumt dieses Skript ab:
#
#   config/plugins/<x>.backup.json        - die Zweitschrift der Einstellungen,
#                                           von der Oberflaeche beim Speichern
#                                           geschrieben
#   data/plugins/<x>.upgrade_sicherung    - die Sicherung waehrend des Updates
#
# Aufruf: <ZUFALLSKENNUNG> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# $1 ist NICHT der Arbeitsordner, sondern eine zehnstellige Zufallskennung.
UN_FOLDER="${3:-ferien}"
UN_BASE="${5:-$LBHOMEDIR}"
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE" ]; then
    echo "<INFO> Kein Wurzelverzeichnis uebergeben - nichts abgeraeumt."
    exit 0
fi

rm -f  "$UN_BASE/config/plugins/$UN_FOLDER.backup.json" 2>/dev/null
rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" 2>/dev/null
echo "<OK> Zweitschrift und Update-Sicherung entfernt."
exit 0
