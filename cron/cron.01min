#!/bin/sh
# Ferien und Feiertage - minuetlicher Cron (Datenabruf, Ansage, MQTT)
#
# cron.php liegt seit 1.1.1 unter bin/ statt unter webfrontend/html/. Es wird
# nur von hier aufgerufen, ueber die PHP-Kommandozeile; im HTML-Verzeichnis
# war es zusaetzlich fuer jeden im Heimnetz per HTTP abrufbar.
#
# Den bin- und den log-Pfad des Plugins setzt der Installer in den Zeilen ein.
#
# I8 (1.2.16), Hausstandard (Regeln/06, Bauform Docker NG 1.3.7 und
# Abfahrts-Assistent 1.6.10): die FEHLERAUSGABE geht nach cron.err im
# Protokollordner, nicht nach /dev/null. LoxBerry ruft jede Cron-Datei mit
# "> /dev/null 2>&1" auf (/etc/cron.d/lbdefaults); bis 1.2.15 schickte auch
# diese Zeile die eigene Fehlerausgabe dorthin - "ferien_lib.php nicht
# gefunden" oder ein Fatal Error verschwanden spurlos. Das Verzeichnis wird
# angelegt (sonst scheitert schon die Umlenkung), touch frischt die
# Aenderungszeit auf (ein Anhaengen ohne Inhalt tut das nicht), ab 256 kB
# bleiben die letzten 300 Zeilen. Der Reiter Logdateien zeigt die Datei,
# sobald etwas darin steht.
#
# Gruppe 19 (1.2.28, FE12; Bauform Dashboard 0.9.38 / Abfahrts-Assistent 1.6.31 F3): scheitert touch -
# Protokollordner root-eigen, RAM-Scheibe voll -, laeuft cron.php trotzdem, nur ohne cron.err. Bis 1.2.27 scheiterte
# dann schon die Umlenkung "2>>", und cron.php lief gar nicht.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

ERR="REPLACELBPLOGDIR/cron.err"
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
# 1.2.30 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): touch allein genuegt nicht - es gelingt auch auf einem
# Verzeichnis und, beim Eigentuemer, auf einer schreibgeschuetzten Datei. Bis 1.2.29 brach dann die Umlenkung
# den Befehl ab, BEVOR er startete.
if touch "$ERR" 2>/dev/null && [ -f "$ERR" ] && [ -w "$ERR" ]; then
    if [ "$(stat -c %s "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -n 300 "$ERR" > "$ERR.neu" 2>/dev/null && mv -f "$ERR.neu" "$ERR"
    fi
    php "REPLACELBPBINDIR/cron.php" >/dev/null 2>>"$ERR"
else
    php "REPLACELBPBINDIR/cron.php" >/dev/null 2>&1
fi
exit 0
